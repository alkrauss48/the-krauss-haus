{
	"name": "the-krauss-haus",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"images:webp": "mkdir -p dist/full dist/thumb && find pngs -maxdepth 1 -name '*.png' -print0 | xargs -0 -n 1 -P \"$(sysctl -n hw.ncpu)\" sh -c 'n=$(basename \"$1\" .png); cwebp -q 50 -resize 0 640 -m 6 -sharp_yuv -af -sns 80 -f 70 -pass 8 -alpha_filter best -alpha_q 70 -quiet \"$1\" -o \"dist/full/$n.webp\"; cwebp -q 55 -resize 0 160 -m 6 -sharp_yuv -af -sns 80 -f 70 -pass 8 -alpha_filter best -alpha_q 70 -quiet \"$1\" -o \"dist/thumb/$n.webp\"' _",
		"images:clean": "rm -rf dist"
	},
	"devDependencies": {
		"@csstools/postcss-oklab-function": "^4.0.10",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.6",
		"vitest": "^3.0.0"
	}
}
