# GitHub PAT used by the `gh` CLI for opening pull requests.
GH_TOKEN=

# The ask-eddie API. Server-side only — never prefix these PUBLIC_, or the key
# lands in the browser bundle and anyone who reads it can spend the AI budget.
BAR_API_URL=http://localhost:9000
BAR_API_KEY=

# Optional tuning, shown with the defaults the code assumes.
BAR_CLIENT_RATE_PER_MIN=8     # per-visitor cap enforced in the proxy
BAR_CONNECT_TIMEOUT_MS=30000  # time allowed to get response headers back
BAR_IDLE_TIMEOUT_MS=60000     # time allowed between stream chunks
